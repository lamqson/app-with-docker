{
  "name": "raindrop-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3200",
    "predev": "npm run generate:static-pages",
    "generate:static-pages": "tsx scripts/generate-static-pages.mjs",
    "scrape:top-banner": "python3 scripts/scrape-raindrop-nav.py hype-cycle-for-procurement-sourcing-2026 understanding-agentic-ai-and-its-role-in-procurement solutions/modules/contract-lifecycle-management && npm run generate:static-pages",
    "prebuild": "npm run generate:static-pages",
    "build": "next build",
    "start": "next start -p 3200",
    "lint": "eslint",
    "ci:migrate": "node scripts/migrate-if-ready.mjs",
    "ci": "npm run ci:migrate && npm run build",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "npm run payload generate:types",
    "generate:importmap": "npm run payload generate:importmap",
    "db:seed": "cross-env NODE_OPTIONS=--no-deprecation tsx src/payload/seed/index.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.90.1",
    "@payloadcms/db-sqlite": "^3.90.1",
    "@payloadcms/next": "^3.90.1",
    "@payloadcms/richtext-lexical": "^3.90.1",
    "dotenv": "^18.0.1",
    "graphql": "^16.8.1",
    "next": "^16.3.5",
    "next-intl": "^4.14.5",
    "payload": "^3.90.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.16.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
