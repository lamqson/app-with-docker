# Secrets — never commit
wp-config.php
wp-config-*.php
.env
.env.*
!.env.example
*.pem
*.key

# WordPress core (this repo is theme + optional plugins only)
/wordpress/
/wp-admin/
/wp-includes/
/wp-*.php
/xmlrpc.php
/license.txt
/readme.html
/index.php

# Host / runtime junk
wp-content/uploads/
wp-content/upgrade/
wp-content/cache/
wp-content/backup*/
wp-content/backups/
wp-content/upgrade-temp-backup/
wp-content/advanced-cache.php
wp-content/object-cache.php
wp-content/debug.log

# Third-party plugins someone might drop in locally
wp-content/plugins/*
!wp-content/plugins/README.md
!wp-content/plugins/raindrop-*/

# Dependencies
/vendor/
/node_modules/

# Next.js / Payload
/.next/
/out/
/payload.sqlite
/payload.sqlite-*
/media/

# OS / editor
.DS_Store
Thumbs.db
.idea/
*.log
next-env.d.ts
